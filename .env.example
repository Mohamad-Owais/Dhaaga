# ------------------------------------------------------------------
# Dhaaga — environment configuration
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# The API key stays on the server only. It is never sent to the browser.
# ------------------------------------------------------------------

# Required: your Sarvam AI subscription key (from https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_subscription_key_here

# Optional: server port (defaults to 3000)
PORT=3000

# Optional overrides for the Sarvam models used.
# Speech-to-text model. saaras:v3 (default here) or saaras:v4.
SARVAM_STT_MODEL=saaras:v3
# Translation model. sarvam-translate:v1 covers all 22 scheduled Indian languages
# (including Kashmiri and Urdu). mayura:v1 covers 11 languages only.
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# Optional: use a Sarvam text-generation model (e.g. sarvam-m) to name the story.
# Leave EMPTY to generate the title locally, with no extra API call (recommended
# for a live demo — it always works). Set to e.g. "sarvam-m" to try the model first,
# falling back to the local title generator automatically.
SARVAM_TITLE_MODEL=
